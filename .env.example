# Website
HOST=0.0.0.0
PORT=8000
RUN_SCHEDULER=true
REPORT_TIMEZONE=Asia/Shanghai
REPORT_HOUR=6
REPORT_MINUTE=0
DATA_DIR=data

# Email. Gmail requires an app password when 2FA is enabled.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=
EMAIL_TO=prometheus.mr.cy@gmail.com

# Optional: improves the Chinese analysis section.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Optional: override market symbols if a provider changes ticker names.
NASDAQ100_SYMBOL=^NDX
SP500_SYMBOL=^GSPC
KOREA_INDEX_SYMBOLS=^KS11,^KQ11
JAPAN_INDEX_SYMBOLS=^N225
HK_INDEX_SYMBOLS=HSTECH.HK,159699.SZ
COMMODITY_SYMBOLS=GC=F,SI=F,PL=F,HG=F,CL=F,BZ=F
BOND_SYMBOLS=^IRX,^FVX,^TNX,^TYX

# Optional RSS URLs, separated by commas. Defaults are used when empty.
NEWS_RSS_URLS=
TRUMP_SOURCE_URL=
